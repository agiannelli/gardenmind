// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Garden {
  id             String         @id @default(cuid())
  userId         String         // Auth0 user sub (owner)
  name           String
  description    String?
  color          String         @default("#84A98C")
  beds           Bed[]
  members        GardenMember[]
  journalEntries JournalEntry[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String   // Auth0 user sub
  gardenId  String
  garden    Garden   @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  bedId     String?  // Optional — links to a specific bed
  type      String   // "observation" | "pest" | "harvest" | "watering"
  title     String
  notes     String   @default("")
  tags      Json     @default("[]")   // string[]
  photos    Json     @default("[]")   // string[] — Vercel Blob URLs
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([gardenId])
  @@index([bedId])
}

model GardenMember {
  id          String   @id @default(cuid())
  gardenId    String
  garden      Garden   @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  email       String
  userId      String?  // Auth0 sub, populated when invite is accepted
  role        String   @default("editor") // "editor" | "viewer"
  inviteToken String?  @unique
  status      String   @default("pending") // "pending" | "accepted"
  createdAt   DateTime @default(now())

  @@index([gardenId])
  @@index([userId])
}

model Bed {
  id          String   @id @default(cuid())
  userId      String   // Auth0 user sub (creator)
  gardenId    String?
  garden      Garden?  @relation(fields: [gardenId], references: [id], onDelete: SetNull)
  name        String
  widthFt     Int      // Width in feet
  lengthFt    Int      // Length in feet
  sunExposure String   // "full-sun" | "partial-sun" | "full-shade"
  gardenType  String   @default("square-foot")  // "traditional" | "square-foot" | "intensive"
  color       String   // Hex color code
  cells       Json     @default("{}")  // Record<string, CellData>
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([gardenId])
}
