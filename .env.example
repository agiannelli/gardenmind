# Auth0 — https://manage.auth0.com
AUTH0_SECRET=          # run: openssl rand -hex 32
AUTH0_BASE_URL=        # e.g. http://localhost:3000
AUTH0_ISSUER_BASE_URL= # e.g. https://YOUR_DOMAIN.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=         # e.g. postgresql://USER:PASSWORD@HOST:PORT/DATABASE